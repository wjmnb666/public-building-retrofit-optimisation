{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent 2 automated evaluator output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "candidate_type",
    "pass",
    "schema_or_structure_issues",
    "unsupported_values",
    "unsupported_units",
    "unsupported_years",
    "unsupported_sources",
    "unsupported_claims",
    "unsupported_packages",
    "unsupported_action_years",
    "reversed_comparisons",
    "omitted_conditions",
    "exaggerated_certainty",
    "recommendation_overreach",
    "planning_evidence_misclassification",
    "revision_instruction",
    "reason"
  ],
  "properties": {
    "task_id": {"type": "string", "minLength": 1},
    "candidate_type": {"type": "string", "enum": ["parameter", "narrative"]},
    "pass": {"type": "boolean"},
    "schema_or_structure_issues": {"type": "array", "items": {"type": "string"}},
    "unsupported_values": {"type": "array", "items": {"type": "string"}},
    "unsupported_units": {"type": "array", "items": {"type": "string"}},
    "unsupported_years": {"type": "array", "items": {"type": "string"}},
    "unsupported_sources": {"type": "array", "items": {"type": "string"}},
    "unsupported_claims": {"type": "array", "items": {"type": "string"}},
    "unsupported_packages": {"type": "array", "items": {"type": "string"}},
    "unsupported_action_years": {"type": "array", "items": {"type": "string"}},
    "reversed_comparisons": {"type": "array", "items": {"type": "string"}},
    "omitted_conditions": {"type": "array", "items": {"type": "string"}},
    "exaggerated_certainty": {"type": "array", "items": {"type": "string"}},
    "recommendation_overreach": {"type": "array", "items": {"type": "string"}},
    "planning_evidence_misclassification": {"type": "array", "items": {"type": "string"}},
    "revision_instruction": {"type": "string"},
    "reason": {"type": "string"}
  }
}
